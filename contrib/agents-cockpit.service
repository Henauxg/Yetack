# The agents-cockpit daemon as a systemd user service.
#
# Install:
#   cp contrib/agents-cockpit.service ~/.config/systemd/user/
#   systemctl --user daemon-reload
#   systemctl --user enable --now agents-cockpit
#   loginctl enable-linger "$USER"    # keeps it running after you log out
#
# Edit ExecStart if agents-cockpit is not in ~/.cargo/bin, and PATH so that it finds `claude`.

[Unit]
Description=agents-cockpit daemon: Claude Code agents steered from the desktop app

[Service]
Type=exec
ExecStart=%h/.cargo/bin/agents-cockpit serve
Environment=PATH=%h/.local/bin:%h/.cargo/bin:%h/.nix-profile/bin:/etc/profiles/per-user/%u/bin:/run/current-system/sw/bin:/usr/local/bin:/usr/bin:/bin
UMask=0077
# SIGTERM goes to the daemon alone: it stops with its agents still marked as running, so the next
# start resumes them. Their `claude` processes end with it.
KillMode=mixed
TimeoutStopSec=30
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
